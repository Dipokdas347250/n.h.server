# Database
DB_DATA_URL=mongodb://127.0.0.1:27017/nh-shop

# HTTP
NODE_ENV=development
PORT=8080
BASE_ROUTE=/api/v1
# Public base URL of this API, used to build payment gateway callback URLs
PUBLIC_SERVER_URL=http://localhost:8080
# Public base URL of the storefront, used to redirect after payment
STORE_URL=http://localhost:3000
# Comma separated list of browser origins allowed to send the session cookie
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Merchants
# Length of the free trial a newly approved merchant gets, in days.
MERCHANT_TRIAL_DAYS=7
# Default monthly subscription fee (BDT) offered when approving a merchant.
# Each merchant's fee can be changed afterwards in Dashboard -> Merchants.
MERCHANT_MONTHLY_FEE=0
# Default monthly fee is also editable in Store settings -> Merchant subscriptions.
# Starting values for Dashboard -> Store settings -> Merchant subscriptions
# (only used until they are saved there): days a verified payment lasts, and
# days an expired account keeps working before it is suspended automatically.
MERCHANT_PERIOD_DAYS=30
MERCHANT_GRACE_DAYS=3
# NID numbers are stored encrypted. Set a long random value (for example
# `openssl rand -hex 32`) BEFORE the first start of this version, keep a backup,
# and never change it: NIDs encrypted with one key cannot be read with another.
NID_ENCRYPTION_KEY=

# Merchant applications: the NID number typed is compared with the number read
# off the front photo. The reader downloads its English language data once from
# the tesseract.js CDN; to run offline, point this at a folder holding
# eng.traineddata (optional).
NID_OCR_LANG_PATH=
# Dashboard address, linked from merchant notice emails (optional).
DASHBOARD_URL=http://localhost:5173

# Sessions
SESSION_SECRET=change-me

# Email (OTP delivery)
#
# Option A - Gmail. Fine for testing. AUTH_PASSWORD must be an App Password,
# not the account password: turn on 2-Step Verification, then generate one at
# https://myaccount.google.com/apppasswords
# Limits: ~500 recipients/day, and mail from a personal @gmail.com address is
# more likely to be filtered when you send to other Gmail users.
#
# Option B - a transactional provider on your own domain (recommended for
# production). Verify your domain with the provider so DKIM, SPF and DMARC all
# pass, then just change the four values below. No code changes needed.
#   Brevo    SMTP_HOST=smtp-relay.brevo.com     SMTP_PORT=587  SMTP_SECURE=false
#   Resend   SMTP_HOST=smtp.resend.com          SMTP_PORT=465  SMTP_SECURE=true
#   SendGrid SMTP_HOST=smtp.sendgrid.net        SMTP_PORT=587  SMTP_SECURE=false
# With a provider, AUTH_EMAIL is the verified From address on your domain
# (e.g. no-reply@nhshop.com.bd) and AUTH_PASSWORD is the provider's API key.
AUTH_EMAIL=you@example.com
AUTH_PASSWORD=your-16-character-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Shown as the sender name and inside the verification email
STORE_NAME=N H Shop
STORE_NAME_BN=এন এইচ শপ
SUPPORT_EMAIL=support@example.com
OTP_EXPIRY_MINUTES=5

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
API_SECRET=

# Steadfast Courier (optional). Usually entered in Dashboard -> Store settings
# instead; these are only used when no keys are saved there.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# SSLCommerz online payments
STORE_ID=
STORE_PASSWORD=
SSL_IS_LIVE=false
